SERVER_PORT=8080
# Local development only. Do not enable the dev profile in production.
SPRING_PROFILES_ACTIVE=dev

DB_HOST=your_supabase_host
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=your_database_password
DB_SCHEMA=public
DB_SSL_MODE=require

FRONTEND_URL=http://localhost:3000

APP_TIMEZONE=Asia/Ho_Chi_Minh
SESSION_TIMEOUT=90m
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_JDBC_INITIALIZE_SCHEMA=always

JPA_DDL_AUTO=update
DB_POOL_SIZE=5
# Keep disabled during normal startup. Setting this to always executes the
# destructive demo seed (TRUNCATE + re-import from the three PDF schedules).
SQL_INIT_MODE=never

# In-app notification reminders (hours before the task) and polling interval for the scheduler.
NOTIFICATION_REMINDER_HOURS=12,2
NOTIFICATION_SCHEDULER_DELAY_MS=60000
